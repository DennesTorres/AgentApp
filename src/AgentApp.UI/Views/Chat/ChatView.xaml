<UserControl x:Class="AgentApp.UI.Views.Chat.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- US-157: Active project indicator / US-134: Execution state -->
        <Border Grid.Row="0" Background="#1E1E2E" Padding="12,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveProjectName}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Project: " Foreground="#888" FontSize="12" />
                    <TextBlock Text="{Binding ActiveProjectName}" Foreground="#A0C4FF"
                               FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="State: " Foreground="#888" FontSize="12" />
                    <TextBlock Text="{Binding CurrentState}" Foreground="#B5CEA8"
                               FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Message list (US-151: agent persona) -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Messages}"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 BorderThickness="0"
                 Margin="8,8,8,4">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="2,3" Padding="10,6" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#2D2D30" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter Property="Background" Value="#1A3A5C" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel MaxWidth="560">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <!-- C-030/C-031: Agent avatar — person icon, colored by preset, custom image overrides -->
                                <Border Width="30" Height="30" CornerRadius="15"
                                        Background="{Binding DataContext.AgentAvatarColor,
                                            RelativeSource={RelativeSource AncestorType=ListBox},
                                            Converter={StaticResource StringToBrushConverter}}"
                                        Margin="0,0,6,0" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAgent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- Custom image (when path is set) -->
                                        <Image Source="{Binding DataContext.AgentAvatarImagePath,
                                                       RelativeSource={RelativeSource AncestorType=ListBox},
                                                       Converter={StaticResource FilePathToImageSourceConverter}}"
                                               Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.AgentAvatarImagePath,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- C-044: Shape avatar (when no custom image) — shape chosen by AgentAvatarShape -->
                                        <Viewbox Margin="3">
                                            <Viewbox.Style>
                                                <Style TargetType="Viewbox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.AgentAvatarImagePath,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Viewbox.Style>
                                            <Path Fill="White" Opacity="0.9" Width="24" Height="24" Stretch="Uniform"
                                                  Data="{Binding DataContext.AgentAvatarShape,
                                                         RelativeSource={RelativeSource AncestorType=ListBox},
                                                         Converter={StaticResource ShapeToPathDataConverter}}" />
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <!-- C-030/C-031: User avatar — same pattern with user color -->
                                <Border Width="30" Height="30" CornerRadius="15"
                                        Background="{Binding DataContext.UserAvatarColor,
                                            RelativeSource={RelativeSource AncestorType=ListBox},
                                            Converter={StaticResource StringToBrushConverter}}"
                                        Margin="0,0,6,0" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Image Source="{Binding DataContext.UserAvatarImagePath,
                                                       RelativeSource={RelativeSource AncestorType=ListBox},
                                                       Converter={StaticResource FilePathToImageSourceConverter}}"
                                               Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.UserAvatarImagePath,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- C-044: Shape avatar (user) -->
                                        <Viewbox Margin="3">
                                            <Viewbox.Style>
                                                <Style TargetType="Viewbox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.UserAvatarImagePath,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Viewbox.Style>
                                            <Path Fill="White" Opacity="0.9" Width="24" Height="24" Stretch="Uniform"
                                                  Data="{Binding DataContext.UserAvatarShape,
                                                         RelativeSource={RelativeSource AncestorType=ListBox},
                                                         Converter={StaticResource ShapeToPathDataConverter}}" />
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Role}"
                                           FontSize="10" FontWeight="Bold"
                                           Opacity="0.6" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Timestamp}"
                                       FontSize="10" Opacity="0.4"
                                       HorizontalAlignment="Right" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- US-153: Project confirm panel -->
        <Border Grid.Row="2" Background="#1A2A1A" Padding="12,8" Margin="8,0,8,4" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProjectConfirmPending}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PendingProjectSummary}"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="#A8D8A8" FontSize="12" />
                <Button Grid.Column="1" Content="Confirm"
                        Command="{Binding ConfirmProjectCommand}"
                        Margin="8,0,4,0" MinWidth="70" MinHeight="30" />
                <Button Grid.Column="2" Content="Cancel"
                        Command="{Binding CancelProjectCommand}"
                        MinWidth="70" MinHeight="30" />
            </Grid>
        </Border>

        <!-- US-163: Path permission request panel -->
        <Border Grid.Row="3" Background="#2A1A2A" Padding="12,8" Margin="8,0,8,4" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPermissionRequestPending}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PendingPermissionSummary}"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="#D8A8D8" FontSize="12" />
                <Button Grid.Column="1" Content="Allow"
                        Command="{Binding ApprovePermissionCommand}"
                        Margin="8,0,4,0" MinWidth="70" MinHeight="30" />
                <Button Grid.Column="2" Content="Deny"
                        Command="{Binding DenyPermissionCommand}"
                        MinWidth="70" MinHeight="30" />
            </Grid>
        </Border>

        <!-- Input row -->
        <Grid Grid.Row="4" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputTextBox"
                     Grid.Column="0"
                     Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,6,0"
                     MinHeight="36"
                     MaxHeight="120"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="InputTextBox_PreviewKeyDown"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverseConverter}}" />
            <Button Grid.Column="1"
                    Content="Send"
                    Command="{Binding SendMessageCommand}"
                    MinWidth="80" MinHeight="36" />
        </Grid>
    </Grid>
</UserControl>
