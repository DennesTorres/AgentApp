<UserControl x:Class="AgentApp.UI.Views.Sessions.SessionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top toolbar: New session with project selector (C-069) -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
            <TextBlock Text="Project:" Foreground="#A0A0B0" FontSize="11" Margin="0,0,0,2" />
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding AvailableProjects}"
                          SelectedItem="{Binding SelectedNewSessionProject}"
                          DisplayMemberPath="Name"
                          MinWidth="160" MinHeight="28"
                          Margin="0,0,6,0"
                          ToolTip="Choose the project for the new session (or no project for standalone)" />
                <Button Content="+ New Session"
                        Command="{Binding CreateSessionCommand}"
                        MinWidth="110" MinHeight="28"
                        ToolTip="Create a new chat session" />
            </StackPanel>
        </StackPanel>

        <!-- US-185/C-065: Session list grouped by project -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding SessionsView}"
                 SelectedItem="{Binding SelectedSession}"
                 BorderThickness="1"
                 Margin="0,0,0,8">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <!-- C-065: visually distinct project group header with left accent border -->
                            <Border Background="#23233A" BorderBrush="#4A4A80" BorderThickness="3,0,0,0"
                                    Margin="0,8,0,0" Padding="6,4,4,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Group name: project name or "(No Project)" -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               Foreground="#9CDCFE"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <!-- + New in project button (passes ProjectGroupKey as parameter) -->
                                    <Button Grid.Column="1"
                                            Content="+ New"
                                            Command="{Binding DataContext.CreateSessionInGroupCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding Name}"
                                            MinWidth="60" MinHeight="22"
                                            Margin="8,0,0,0"
                                            FontSize="11"
                                            ToolTip="New session in this project" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,0,4,0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Normal view: double-click to rename (C-032, C-052) -->
                        <StackPanel Grid.Column="0" MouseLeftButtonDown="NamePanel_MouseLeftButtonDown">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock FontSize="11" Opacity="0.6" Text="{Binding CreatedAt, Mode=OneTime}" />
                        </StackPanel>

                        <!-- Inline rename TextBox: visible when IsRenaming; auto-focused via code-behind (C-052) -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding RenameBuffer, UpdateSourceTrigger=PropertyChanged}"
                                 IsVisibleChanged="RenameTextBox_IsVisibleChanged"
                                 KeyDown="RenameTextBox_KeyDown"
                                 LostFocus="RenameTextBox_LostFocus"
                                 VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- US-187: Archive -->
                        <Button Grid.Column="1" Content="Archive"
                                Command="{Binding DataContext.ArchiveSessionCommand,
                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                MinWidth="70" MinHeight="26" Margin="4,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                   Foreground="#A0C4FF" FontSize="12" Opacity="0.8" />
    </Grid>
</UserControl>
