<UserControl x:Class="AgentApp.UI.Views.Settings.ProjectSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700">
    <StackPanel Margin="16" MaxWidth="600">

        <TextBlock Text="Project ID" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ProjectId, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="30" Margin="0,0,6,0" />
            <Button Grid.Column="1" Content="Load" Command="{Binding LoadProjectSettingsCommand}"
                    MinWidth="70" MinHeight="30" />
        </Grid>

        <TextBlock Text="Overrides (leave blank to use global default)"
                   Foreground="#888" FontSize="11" Margin="0,0,0,8" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Max Gate Retries" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding MaxGateRetries, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="30" />
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Token Threshold for Context Reset" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding TokenThresholdForContextReset, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="30" />
        </Grid>

        <CheckBox Content="Require confirmation for internal learning"
                  IsChecked="{Binding RequireUserConfirmationForInternalLearning}"
                  Margin="0,0,0,6" />
        <CheckBox Content="Require confirmation for findings extraction"
                  IsChecked="{Binding RequireUserConfirmationForFindingsExtraction}"
                  Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Save" Command="{Binding SaveProjectSettingsCommand}"
                    MinWidth="80" MinHeight="30" Margin="0,0,8,0" />
            <Button Content="Clear to Defaults" Command="{Binding ClearProjectSettingsCommand}"
                    MinWidth="120" MinHeight="30" />
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" Foreground="#A0C4FF"
                   FontSize="12" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
