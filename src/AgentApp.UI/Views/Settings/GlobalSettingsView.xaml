<UserControl x:Class="AgentApp.UI.Views.Settings.GlobalSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="600">

            <!-- API Key -->
            <TextBlock Text="API Key" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="#A0C4FF" />
            <PasswordBox x:Name="ApiKeyBox" MinHeight="32" Margin="0,0,0,12" />

            <!-- File system -->
            <TextBlock Text="Root Project Folder" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,4" />
            <TextBox Text="{Binding RootProjectFolderPath, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="30" Margin="0,0,0,8" />

            <TextBlock Text="Source Control Root" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,4" />
            <TextBox Text="{Binding SourceControlRoot, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="30" Margin="0,0,0,12" />

            <!-- Gate settings -->
            <TextBlock Text="Gate Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="#A0C4FF" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Max Gate Retries" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding MaxGateRetries, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="30" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Token Threshold for Context Reset" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding TokenThresholdForContextReset, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="30" />
            </Grid>

            <!-- Confirmation toggles -->
            <TextBlock Text="User Confirmation" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="#A0C4FF" />
            <CheckBox Content="Require confirmation for internal learning"
                      IsChecked="{Binding RequireUserConfirmationForInternalLearning}"
                      Margin="0,0,0,6" />
            <CheckBox Content="Require confirmation for findings extraction"
                      IsChecked="{Binding RequireUserConfirmationForFindingsExtraction}"
                      Margin="0,0,0,12" />

            <!-- C-014: Avatar letters -->
            <TextBlock Text="Avatars" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="#A0C4FF" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Agent Avatar Letter" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding AgentAvatarLetter, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="1" MinHeight="30" />
            </Grid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="User Avatar Letter" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding UserAvatarLetter, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="1" MinHeight="30" />
            </Grid>

            <Button Content="Save Settings" Command="{Binding SaveCommand}"
                    MinWidth="120" MinHeight="34" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A0C4FF"
                       FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
